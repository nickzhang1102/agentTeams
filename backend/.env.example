# 应用环境（development / production / testing）
# 默认不设置，按生产姿态启动（fail-closed，见 config.py）。
# 【Docker Compose 部署】无需设置——docker-compose.yml 会强制注入 APP_ENV=production。
# 【本地开发】取消下一行注释（此时初始管理员为 admin/admin123，仅限本机调试）：
# APP_ENV=development

# ==================== 安全配置（必须设置）====================
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
# 警告: 生产环境必须使用不同的随机密钥！
SECRET_KEY=your-secret-key-at-least-32-characters-long-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-at-least-32-characters-long-change-in-production

# 初始管理员密码（可选，推荐设置）
# 首次启动创建 admin 账号时若设置了本变量（至少 8 位、含字母和数字），
# 将直接用它作为 admin 的初始密码——不再随机生成、不打印到 docker logs。
# 仅在首次创建时生效，不会覆盖已存在的账号。忘记密码或被锁时重置：
#   docker compose exec -e ADMIN_INITIAL_PASSWORD='新密码' backend python reset_admin.py
# ADMIN_INITIAL_PASSWORD=

# 密码策略（可选，取消注释即覆盖默认值；对注册和新设密码生效）
# PASSWORD_MIN_LENGTH=8
# PASSWORD_REQUIRE_LETTER=true
# PASSWORD_REQUIRE_DIGIT=true

# LLM 模型、Base URL、API Key 和输出上限统一在后台“LLM 模型”中配置。
# Exa/Tavily API Key 统一在后台“系统设置”中配置。

# PostgreSQL 数据库连接
# 格式: postgresql+psycopg://用户名:密码@主机:端口/数据库名
#
# 【Docker Compose 部署】保持默认即可：容器内由 docker-compose.yml 自动注入服务名地址
#   （@postgres:5432）并覆盖本值；数据库账号口令由 compose 的 POSTGRES_USER /
#   POSTGRES_PASSWORD 控制（默认 postgres/postgres），改本文件不生效。
# 【本地开发】改为指向宿主机数据库：
#   - 宿主机自装 PostgreSQL:   ...@localhost:5432/agent_teams
#   - 复用 compose 起的数据库:  ...@localhost:5433/agent_teams（compose 把 5432 映射到宿主回环 5433）
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/agent_teams

# 测试数据库连接（本地运行 pytest 前必须单独建库并在此配置）
# 测试会清空目标库全部表，绝不使用主库！建议库名以 _test 结尾：
# CREATE DATABASE agent_teams_test;
# 注意：若数据库由 docker compose 提供，宿主端口是 5433 而非 5432
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent_teams_test

# 文件存储配置
FILE_STORAGE_PATH=data/files
WORKSPACE_DIR=data/workspace

# Agents 配置目录
# 【Docker Compose 部署】无需修改——compose 注入 AGENTS_DIR=/app/agents 并覆盖本值
# 【本地开发】保持默认（相对 backend/ 目录的 ../agents）
AGENTS_DIR=../agents

# CORS 跨域配置（可选）
# 【Docker Compose 部署】前端与 API 同源（nginx 反代 /api/），走下面的默认值即可；
#   换 IP/域名访问仍属同源，同样无需修改。跨域嵌入 iframe 见下方 AGENTTEAMS_EMBED_FRAME_ANCESTORS。
# 【本地开发】Vite(5173) 直连后端(5000)，需保留以下来源。
# 公网跨域部署: 追加你的域名，如 https://example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 日志配置（可选）
LOG_LEVEL=info
# 日志展示时区；数据库时间仍使用 UTC
LOG_TIMEZONE=Asia/Shanghai
# JSON 结构化日志（容器日志采集场景开启）
# STRUCTURED_LOGGING=false

# 反向代理信任开关（可选，默认 false）
# 仅当应用位于可信反代（如项目自带 nginx）之后时开启：限流按 X-Forwarded-For
# 的最右条目（由可信代理追加的真实来源 IP）计数。直连部署必须保持 false，
# 否则客户端可伪造该头获得无限限流桶。Docker Compose 部署（经 nginx）建议设为 true。
# TRUST_PROXY=false

# MCP 子进程环境变量透传（可选，逗号分隔）
# MCP server 子进程默认只继承 PATH 等系统变量白名单（不透传后端密钥），
# 服务器自身需要而白名单未含的变量在这里显式声明，例如:
# MCP_ENV_PASSTHROUGH=HTTP_PROXY,HTTPS_PROXY

# OpenHarness 配置（可选）
# 是否启用 OpenHarness 工具调用集成（默认: true）
OPENHARNESS_ENABLED=true
# 是否启用工具调用（默认: true）
OPENHARNESS_TOOLS_ENABLED=true
# 是否向技术类 Agent 分配 shell 类工具 bash/edit_file（默认: false）
# 注意：这类工具与后端同用户运行、无容器隔离，开启前阅读 SECURITY.md「工具执行边界」
OPENHARNESS_SHELL_TOOLS_ENABLED=false
# 工具执行超时时间（秒，默认: 300）
OPENHARNESS_TOOLS_TIMEOUT=300
# 是否启用协调器（多 Agent 并行执行，默认: true）
OPENHARNESS_COORDINATOR_ENABLED=true
# Agent 最大迭代次数（默认: 10）
MAX_AGENT_ITERATIONS=10
# 最大并行 Agent 数（默认: 5）
MAX_AGENT_PARALLEL=5
# 记忆系统开关（默认: true）
OPENHARNESS_MEMORY_ENABLED=true
# 记忆压缩阈值（消息数，默认: 50）
OPENHARNESS_MEMORY_MAX_MESSAGES=50
# 权限治理开关（默认: true）
OPENHARNESS_PERMISSION_ENABLED=true
# 钩子系统开关（默认: true）
OPENHARNESS_HOOKS_ENABLED=true
# 钩子执行超时（秒，默认: 10）
OPENHARNESS_HOOKS_TIMEOUT=10

# ==================== LangGraph Leader 编排配置（可选）====================
# Leader 工作流配置（可选，有默认值）
# ASSESSMENT_THRESHOLD=60  # 评估阈值，低于此值自动执行，高于则组建团队
# Leader SSE 流最大时长（秒，默认 3600）
# LEADER_SSE_MAX_DURATION=3600
# 残留会话清理阈值（分钟，默认 30，取 max(本值, SSE 时长+宽限)）
# STALE_SESSION_TIMEOUT_MINUTES=30
# SSE 最长执行时间外再保留 5 分钟，避免合法长任务被 stale 清理
STALE_SESSION_GRACE_SECONDS=300

# ==================== 知识库数据目录 ====================
# 文档存储、图谱提取输出、用户级图谱 JSON 的根目录。
# Docker 部署由 docker-compose.yml 注入 /app/data/knowledge（挂载卷内），无需在此设置；
# 本地开发默认仓库根 data/knowledge（backend/ 的上一级），通常也无需设置。
# KNOWLEDGE_DATA_DIR=data/knowledge

# Agent Teams durable launch 租约与 iframe 来源策略
AGENTTEAMS_LAUNCH_LEASE_SECONDS=120
AGENTTEAMS_LAUNCH_HEARTBEAT_SECONDS=30
# 多个允许来源以空格分隔，例如: 'self' https://agentteams.example.com
# 同站 /agentteams 反代可保持 'self'；跨域嵌入必须追加 Agent Teams 前端 origin。
# 示例：AGENTTEAMS_EMBED_FRAME_ANCESTORS="'self' https://agentteams.example.com"
# 注意：Docker Compose 部署时此变量由 compose environment 注入并覆盖本文件取值，
# 请在 docker-compose.yml 或根目录环境中设置，改这里不生效。
AGENTTEAMS_EMBED_FRAME_ANCESTORS='self'

# ==================== 知识图谱配置（可选）====================
# 知识图谱提取复用后台配置的默认 LLM。

# Embedding 向量服务（GraphRAG 语义搜索）
# 推荐模型: bge-m3（1024 维，中文优秀）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
# Gunicorn 配置（gunicorn.conf.py 读取；本地与 Docker 均经 start.sh 以 gunicorn 启动）
WORKERS=4
THREADS=2
PORT=5000
