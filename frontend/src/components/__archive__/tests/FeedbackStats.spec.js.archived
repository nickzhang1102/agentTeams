import { describe, it, expect, vi, beforeEach } from 'vitest'
import { mount, flushPromises } from '@vue/test-utils'
import { createPinia, setActivePinia } from 'pinia'
import ElementPlus, { ElCard, ElTabs, ElMessage } from 'element-plus'
import FeedbackStats from '@/components/FeedbackStats.vue'
import api from '@/utils/api'

// Mock api
vi.mock('@/utils/api', () => ({
  default: {
    get: vi.fn()
  }
}))

// Mock ElMessage
vi.mock('element-plus', async () => {
  const actual = await vi.importActual('element-plus')
  return {
    ...actual,
    ElMessage: {
      success: vi.fn(),
      error: vi.fn(),
      warning: vi.fn()
    }
  }
})

describe('FeedbackStats.vue', () => {
  let wrapper

  const mockStatsData = {
    period_days: 7,
    total_ratings: 15,
    agent_result_stats: {
      total: 10,
      likes: 8,
      dislikes: 2,
      like_rate: 80
    },
    final_report_stats: {
      total: 5,
      likes: 3,
      dislikes: 2,
      like_rate: 60
    },
    recent_comments: [
      {
        id: 1,
        target_type: 'agent_result',
        rating: 5,
        comment: '非常好',
        created_at: '2026-06-09T10:00:00Z'
      },
      {
        id: 2,
        target_type: 'final_report',
        rating: 1,
        comment: '需要改进',
        created_at: '2026-06-09T09:00:00Z'
      }
    ]
  }

  function mountFeedbackStats() {
    return mount(FeedbackStats, {
      global: {
        plugins: [ElementPlus]
      }
    })
  }

  beforeEach(() => {
    setActivePinia(createPinia())
    api.get.mockResolvedValue({ data: mockStatsData })
  })

  afterEach(() => {
    if (wrapper) {
      wrapper.unmount()
    }
    vi.clearAllMocks()
  })

  // ==================== 渲染测试 ====================

  it('正常渲染统计卡片', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    expect(wrapper.findComponent(ElCard).exists()).toBe(true)
    expect(wrapper.text()).toContain('反馈统计')
  })

  it('显示周期选择按钮', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    expect(wrapper.text()).toContain('最近7天')
    expect(wrapper.text()).toContain('最近30天')
    expect(wrapper.text()).toContain('最近90天')
  })

  it('显示 4 个 Tab', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    const tabs = wrapper.findComponent(ElTabs)
    expect(tabs.exists()).toBe(true)
    expect(wrapper.text()).toContain('总体')
    expect(wrapper.text()).toContain('Agent 报告')
    expect(wrapper.text()).toContain('最终报告')
    expect(wrapper.text()).toContain('最新评论')
  })

  // ==================== 数据加载测试 ====================

  it('挂载时自动加载统计', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    expect(api.get).toHaveBeenCalledWith('/api/admin/feedback/stats', {
      params: {
        period: '7d',
        target_type: 'all'
      }
    })
  })

  it('切换周期重新加载', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    // 切换到 30 天
    const radioButtons = wrapper.findAll('input[type="radio"]')
    await radioButtons[1].setValue(true)
    await flushPromises()

    expect(api.get).toHaveBeenCalledWith('/api/admin/feedback/stats', {
      params: {
        period: '30d',
        target_type: 'all'
      }
    })
  })

  // ==================== 总体统计 Tab 测试 ====================

  it('总体 Tab 显示统计数据', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    expect(wrapper.text()).toContain('总评分数')
    expect(wrapper.text()).toContain('15')
    expect(wrapper.text()).toContain('统计周期')
    expect(wrapper.text()).toContain('7')
  })

  // ==================== Agent 报告 Tab 测试 ====================

  it('Agent 报告 Tab 显示统计', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    // 切换到 Agent 报告 Tab
    wrapper.vm.activeTab = 'agent_result'
    await wrapper.vm.$nextTick()

    expect(wrapper.text()).toContain('10') // 总数
    expect(wrapper.text()).toContain('8')  // 好评
    expect(wrapper.text()).toContain('2')  // 差评
    expect(wrapper.text()).toContain('80%') // 好评率
  })

  it('Agent 报告好评率颜色正确', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    wrapper.vm.activeTab = 'agent_result'
    await wrapper.vm.$nextTick()

    const color = wrapper.vm.getProgressColor(80)
    expect(color).toBe('#67C23A') // 绿色
  })

  // ==================== 最终报告 Tab 测试 ====================

  it('最终报告 Tab 显示统计', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    wrapper.vm.activeTab = 'final_report'
    await wrapper.vm.$nextTick()

    expect(wrapper.text()).toContain('5') // 总数
    expect(wrapper.text()).toContain('3') // 好评
    expect(wrapper.text()).toContain('2') // 差评
    expect(wrapper.text()).toContain('60%') // 好评率
  })

  it('最终报告好评率颜色正确', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    const color60 = wrapper.vm.getProgressColor(60)
    expect(color60).toBe('#E6A23C') // 橙色

    const color50 = wrapper.vm.getProgressColor(50)
    expect(color50).toBe('#F56C6C') // 红色
  })

  // ==================== 最新评论 Tab 测试 ====================

  it('最新评论 Tab 显示评论列表', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    wrapper.vm.activeTab = 'comments'
    await wrapper.vm.$nextTick()

    expect(wrapper.text()).toContain('非常好')
    expect(wrapper.text()).toContain('需要改进')
    expect(wrapper.text()).toContain('好评')
    expect(wrapper.text()).toContain('差评')
    expect(wrapper.text()).toContain('Agent报告')
    expect(wrapper.text()).toContain('最终报告')
  })

  it('评论时间格式化正确', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    const formattedTime = wrapper.vm.formatTime('2026-06-09T10:30:00Z')
    expect(formattedTime).toMatch(/\d{2}\/\d{2}/) // 月/日 格式
  })

  // ==================== 空数据测试 ====================

  it('无数据时显示空状态', async () => {
    api.get.mockResolvedValue({ data: null })

    wrapper = mountFeedbackStats()
    await flushPromises()

    expect(wrapper.text()).toContain('暂无数据')
  })

  it('无评论时显示空状态', async () => {
    api.get.mockResolvedValue({
      data: { ...mockStatsData, recent_comments: [] }
    })

    wrapper = mountFeedbackStats()
    await flushPromises()

    wrapper.vm.activeTab = 'comments'
    await wrapper.vm.$nextTick()

    expect(wrapper.text()).toContain('暂无评论')
  })

  // ==================== 错误处理测试 ====================

  it('加载失败显示错误', async () => {
    api.get.mockRejectedValue({
      response: { data: { detail: '网络错误' } }
    })

    wrapper = mountFeedbackStats()
    await flushPromises()

    expect(ElMessage.error).toHaveBeenCalledWith('网络错误')
  })

  it('403 权限错误特殊提示', async () => {
    api.get.mockRejectedValue({
      response: { status: 403 }
    })

    wrapper = mountFeedbackStats()
    await flushPromises()

    expect(ElMessage.error).toHaveBeenCalledWith('需要管理员权限')
  })

  it('加载中显示 loading 状态', async () => {
    let resolveRequest
    const slowPromise = new Promise(resolve => {
      resolveRequest = resolve
    })
    api.get.mockReturnValue(slowPromise)

    wrapper = mountFeedbackStats()

    // loading 应为 true
    expect(wrapper.vm.loading).toBe(true)

    resolveRequest({ data: mockStatsData })
    await flushPromises()

    // 加载完成后为 false
    expect(wrapper.vm.loading).toBe(false)
  })

  // ==================== 周期参数测试 ====================

  it('7 天周期参数正确', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    expect(wrapper.vm.period).toBe('7d')
    expect(api.get).toHaveBeenCalledWith(
      expect.any(String),
      expect.objectContaining({
        params: expect.objectContaining({ period: '7d' })
      })
    )
  })

  it('30 天周期参数正确', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    wrapper.vm.period = '30d'
    await wrapper.vm.loadStats()
    await flushPromises()

    expect(api.get).toHaveBeenLastCalledWith(
      expect.any(String),
      expect.objectContaining({
        params: expect.objectContaining({ period: '30d' })
      })
    )
  })

  it('90 天周期参数正确', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    wrapper.vm.period = '90d'
    await wrapper.vm.loadStats()
    await flushPromises()

    expect(api.get).toHaveBeenLastCalledWith(
      expect.any(String),
      expect.objectContaining({
        params: expect.objectContaining({ period: '90d' })
      })
    )
  })

  // ==================== 颜色分级测试 ====================

  it('好评率颜色分级正确', async () => {
    wrapper = mountFeedbackStats()
    await flushPromises()

    expect(wrapper.vm.getProgressColor(90)).toBe('#67C23A')  // >= 80 绿色
    expect(wrapper.vm.getProgressColor(70)).toBe('#E6A23C')  // >= 60 橙色
    expect(wrapper.vm.getProgressColor(40)).toBe('#F56C6C')  // < 60 红色
  })
})
