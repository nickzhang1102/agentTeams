<template>
  <div class="report-feedback">
    <!-- 评分按钮 -->
    <div class="feedback-buttons">
      <el-button
        :type="currentRating === 5 ? 'success' : 'default'"
        :icon="currentRating === 5 ? SuccessFilled : Like"
        size="small"
        :disabled="submitting"
        @click="handleRate(5)"
      >
        {{ currentRating === 5 ? '已点赞' : '点赞' }}
      </el-button>
      <el-button
        :type="currentRating === 1 ? 'danger' : 'default'"
        :icon="currentRating === 1 ? CircleCloseFilled : Dislike"
        size="small"
        :disabled="submitting"
        @click="handleRate(1)"
      >
        {{ currentRating === 1 ? '已差评' : '差评' }}
      </el-button>
    </div>

    <!-- 评论框（评分后显示） -->
    <el-collapse-transition>
      <div v-if="showCommentBox" class="comment-box">
        <el-input
          v-model="commentText"
          type="textarea"
          :rows="3"
          placeholder="可选：说说你的想法（最多2000字）"
          maxlength="2000"
          show-word-limit
          :disabled="submitting"
        />
        <div class="comment-actions">
          <el-button size="small" @click="handleCancelComment">取消</el-button>
          <el-button
            type="primary"
            size="small"
            :loading="submitting"
            @click="handleSubmitComment"
          >
            提交
          </el-button>
        </div>
      </div>
    </el-collapse-transition>

    <!-- 已有评论显示 -->
    <div v-if="currentComment && !showCommentBox" class="existing-comment">
      <el-text type="info" size="small">
        {{ currentComment }}
      </el-text>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, watch } from 'vue'
import { ElMessage } from 'element-plus'
import { SuccessFilled, CircleCloseFilled } from '@element-plus/icons-vue'
import { useLeaderStore } from '@/stores/leader'

const props = defineProps({
  targetType: {
    type: String,
    required: true,
    validator: (value) => ['agent_result', 'final_report'].includes(value)
  },
  targetId: {
    type: Number,
    required: true
  },
  // 初始评分（用于历史会话恢复）
  initialRating: {
    type: Number,
    default: null,
    validator: (value) => value === null || [1, 5].includes(value)
  },
  // 初始评论（用于历史会话恢复）
  initialComment: {
    type: String,
    default: null
  }
})

const leaderStore = useLeaderStore()

const currentRating = ref(props.initialRating)
const currentComment = ref(props.initialComment)
const commentText = ref(props.initialComment || '')
const showCommentBox = ref(false)
const submitting = ref(false)

// 监听 props 变化（用于历史会话切换时更新）
watch(() => props.initialRating, (newVal) => {
  currentRating.value = newVal
})

watch(() => props.initialComment, (newVal) => {
  currentComment.value = newVal
  commentText.value = newVal || ''
})

// 评分逻辑
async function handleRate(rating) {
  if (currentRating.value === rating) {
    // 点击同一按钮，打开评论框（可修改评论）
    showCommentBox.value = true
    return
  }

  // 切换评分，立即提交
  submitting.value = true
  try {
    await leaderStore.submitReportRating(
      props.targetType,
      props.targetId,
      rating,
      currentComment.value || null
    )
    currentRating.value = rating
    ElMessage.success('评分成功')
  } catch (error) {
    console.error('[ReportFeedback] Rate failed:', error)
    ElMessage.error(error.response?.data?.detail || '评分失败')
  } finally {
    submitting.value = false
  }
}

// 提交评论
async function handleSubmitComment() {
  if (!currentRating.value) {
    ElMessage.warning('请先评分')
    return
  }

  submitting.value = true
  try {
    await leaderStore.submitReportRating(
      props.targetType,
      props.targetId,
      currentRating.value,
      commentText.value.trim() || null
    )
    currentComment.value = commentText.value.trim() || null
    showCommentBox.value = false
    ElMessage.success('评论已提交')
  } catch (error) {
    console.error('[ReportFeedback] Submit comment failed:', error)
    ElMessage.error(error.response?.data?.detail || '提交失败')
  } finally {
    submitting.value = false
  }
}

// 取消评论
function handleCancelComment() {
  commentText.value = currentComment.value || ''
  showCommentBox.value = false
}
</script>

<style scoped>
.report-feedback {
  margin-top: 12px;
  padding: 12px;
  background-color: var(--el-fill-color-blank);
  border-radius: 4px;
}

.feedback-buttons {
  display: flex;
  gap: 8px;
}

.comment-box {
  margin-top: 12px;
}

.comment-actions {
  margin-top: 8px;
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}

.existing-comment {
  margin-top: 8px;
  padding: 8px;
  background-color: var(--el-fill-color-light);
  border-radius: 4px;
  font-size: 12px;
  color: var(--el-text-color-secondary);
}
</style>
