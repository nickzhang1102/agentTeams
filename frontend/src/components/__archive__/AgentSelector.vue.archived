<template>
  <el-dialog
    v-model="visible"
    title="选择 Agent"
    :width="dialogWidth"
    :fullscreen="isMobile"
    append-to-body
    :modal-append-to-body="true"
    :lock-scroll="true"
    class="agent-selector-dialog"
    @close="handleClose"
  >
    <div class="selector-container">
      <!-- 搜索框 -->
      <div class="search-bar">
        <el-input
          v-model="searchKeyword"
          placeholder="搜索 Agent..."
          prefix-icon="Search"
          clearable
          @input="handleSearch"
        />
      </div>

      <div class="content-wrapper">
        <!-- 左侧分类树 -->
        <div class="category-tree" :class="{ 'collapsed': isMobile && treeCollapsed }">
          <el-tree
            :data="treeData"
            :props="treeProps"
            node-key="key"
            :default-expanded-keys="expandedKeys"
            :highlight-current="true"
            @node-click="handleCategoryClick"
          >
            <template #default="{ node, data }">
              <span class="tree-node">
                <span v-if="data.icon" class="node-icon">{{ data.icon }}</span>
                <span class="node-label">{{ node.label }}</span>
                <span v-if="data.agentCount" class="agent-count">({{ data.agentCount }})</span>
              </span>
            </template>
          </el-tree>
        </div>

        <!-- 右侧 Agent 列表 -->
        <div class="agent-list">
          <div v-if="loading" class="loading-state">
            <el-icon class="is-loading"><Loading /></el-icon>
            <span>加载中...</span>
          </div>

          <div v-else-if="filteredAgents.length === 0" class="empty-state">
            <span>未找到匹配的 Agent</span>
          </div>

          <div v-else class="agent-grid">
            <AgentCard
              v-for="agent in filteredAgents"
              :key="agent.id"
              :agent="agent"
              :icon="currentCategoryIcon"
              :is-selected="agent.id === selectedAgentId"
              @select="handleAgentSelect"
            />
          </div>
        </div>
      </div>

      <!-- 移动端折叠按钮 -->
      <el-button
        v-if="isMobile"
        class="toggle-tree-btn"
        @click="treeCollapsed = !treeCollapsed"
      >
        {{ treeCollapsed ? '显示分类' : '隐藏分类' }}
      </el-button>
    </div>
  </el-dialog>
</template>

<script setup>
import { ref, computed, watch, onMounted } from 'vue'
import { useAgentsStore } from '@/stores/agents'
import { Loading } from '@element-plus/icons-vue'
import AgentCard from './AgentCard.vue'

const props = defineProps({
  modelValue: {
    type: Boolean,
    default: false
  },
  selectedAgentId: {
    type: String,
    default: null
  }
})

const emit = defineEmits(['update:modelValue', 'select'])

const agentsStore = useAgentsStore()

const visible = computed({
  get: () => props.modelValue,
  set: (val) => emit('update:modelValue', val)
})

const searchKeyword = ref('')
const selectedCategory = ref(null)
const treeCollapsed = ref(true)

// 响应式布局
const isMobile = ref(window.innerWidth < 768)
const dialogWidth = computed(() => isMobile.value ? '100%' : '800px')

// 树状菜单配置
const treeProps = {
  label: 'name',
  children: 'children'
}

const expandedKeys = computed(() => {
  if (agentsStore.agentTree) {
    return Object.keys(agentsStore.agentTree)
  }
  return []
})

// 树状菜单数据
const treeData = computed(() => {
  const tree = []

  if (agentsStore.agentTree) {
    for (const [key, category] of Object.entries(agentsStore.agentTree)) {
      const categoryNode = {
        key: key,
        name: category.name,
        icon: category.icon,
        children: []
      }

      if (category.children) {
        for (const [subKey, subCategory] of Object.entries(category.children)) {
          categoryNode.children.push({
            key: `${key}-${subKey}`,
            name: subCategory.name,
            agentCount: subCategory.agents ? subCategory.agents.length : 0,
            agents: subCategory.agents || [],
            parentIcon: category.icon
          })
        }
      }

      tree.push(categoryNode)
    }
  }

  return tree
})

// 当前分类图标
const currentCategoryIcon = computed(() => {
  if (selectedCategory.value) {
    const [mainKey] = selectedCategory.value.split('-')
    return agentsStore.agentTree[mainKey]?.icon || '🩺'
  }
  return '🩺'
})

// 过滤后的 Agent 列表
const filteredAgents = computed(() => {
  let agents = []

  // 如果有搜索关键词，搜索所有 Agent
  if (searchKeyword.value.trim()) {
    agents = agentsStore.searchAgents(searchKeyword.value)
  }
  // 如果选择了分类，显示该分类的 Agent
  else if (selectedCategory.value) {
    const [mainKey, subKey] = selectedCategory.value.split('-')
    const category = agentsStore.agentTree?.[mainKey]?.children?.[subKey]
    agents = category?.agents || []
  }
  // 否则显示所有 Agent，按分类顺序排列
  else {
    agents = getAgentsSortedByCategory()
  }

  return agents
})

// 按分类顺序获取所有 Agent
function getAgentsSortedByCategory() {
  const result = []
  const tree = agentsStore.agentTree

  if (!tree || Object.keys(tree).length === 0) {
    return agentsStore.agents
  }

  // 按分类树顺序遍历
  for (const categoryKey of Object.keys(tree)) {
    const category = tree[categoryKey]
    if (category.children) {
      for (const subKey of Object.keys(category.children)) {
        const subCategory = category.children[subKey]
        if (subCategory.agents) {
          result.push(...subCategory.agents)
        }
      }
    }
  }

  return result
}

const loading = computed(() => agentsStore.loading)

// 搜索处理（防抖）
let searchTimer = null
function handleSearch() {
  if (searchTimer) clearTimeout(searchTimer)
  searchTimer = setTimeout(() => {
    // 搜索时清空分类选择
    if (searchKeyword.value.trim()) {
      selectedCategory.value = null
    }
  }, 300)
}

// 分类点击处理
function handleCategoryClick(data) {
  if (data.agents) {
    selectedCategory.value = data.key
    searchKeyword.value = ''

    // 移动端自动折叠树
    if (isMobile.value) {
      treeCollapsed.value = true
    }
  }
}

// Agent 选择处理
function handleAgentSelect(agent) {
  emit('select', agent)
  visible.value = false
}

// 关闭处理
function handleClose() {
  searchKeyword.value = ''
  selectedCategory.value = null
}

// 监听窗口大小变化
onMounted(() => {
  window.addEventListener('resize', () => {
    isMobile.value = window.innerWidth < 768
  })

  // 加载分类树数据
  if (!agentsStore.agentTree || Object.keys(agentsStore.agentTree).length === 0) {
    agentsStore.fetchAgentTree()
  }
})
</script>

<style scoped>
.agent-selector-dialog :deep(.el-dialog__body) {
  padding: 0;
}

.selector-container {
  display: flex;
  flex-direction: column;
  height: 600px;
}

.search-bar {
  padding: 16px;
  border-bottom: 1px solid rgba(37, 99, 235, 0.1);
}

.content-wrapper {
  display: flex;
  flex: 1;
  overflow: hidden;
}

.category-tree {
  width: 180px;
  border-right: 1px solid rgba(37, 99, 235, 0.1);
  overflow-y: auto;
  padding: 16px;
  transition: all 0.3s ease;
}

.category-tree.collapsed {
  width: 0;
  padding: 0;
  overflow: hidden;
}

.tree-node {
  display: flex;
  align-items: center;
  gap: 6px;
}

.node-icon {
  font-size: 16px;
}

.node-label {
  flex: 1;
}

.agent-count {
  font-size: 12px;
  color: #909399;
}

.agent-list {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
}

.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #909399;
  gap: 8px;
}

.agent-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.toggle-tree-btn {
  margin: 16px;
}

/* 移动端适配 */
@media (max-width: 768px) {
  .selector-container {
    height: calc(100vh - 120px);
  }

  .agent-grid {
    grid-template-columns: 1fr;
  }

  .category-tree {
    position: absolute;
    left: 0;
    top: 60px;
    bottom: 60px;
    background: white;
    z-index: 10;
    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1);
  }

  .category-tree.collapsed {
    left: -250px;
  }
}
</style>
