<template>
  <el-card class="feedback-stats-card" shadow="hover">
    <template #header>
      <div class="card-header">
        <span>反馈统计</span>
        <el-radio-group v-model="period" size="small" @change="loadStats">
          <el-radio-button value="7d">最近7天</el-radio-button>
          <el-radio-button value="30d">最近30天</el-radio-button>
          <el-radio-button value="90d">最近90天</el-radio-button>
        </el-radio-group>
      </div>
    </template>

    <el-tabs v-model="activeTab" class="stats-tabs">
      <!-- 总体统计 -->
      <el-tab-pane label="总体" name="overall">
        <div v-loading="loading" class="stats-content">
          <el-empty v-if="!stats" description="暂无数据" />
          <template v-else>
            <el-row :gutter="20">
              <el-col :span="12">
                <el-statistic title="总评分数" :value="stats.total_ratings">
                  <template #suffix>条</template>
                </el-statistic>
              </el-col>
              <el-col :span="12">
                <el-statistic title="统计周期" :value="stats.period_days">
                  <template #suffix>天</template>
                </el-statistic>
              </el-col>
            </el-row>
          </template>
        </div>
      </el-tab-pane>

      <!-- Agent 报告统计 -->
      <el-tab-pane label="Agent 报告" name="agent_result">
        <div v-loading="loading" class="stats-content">
          <el-empty v-if="!stats" description="暂无数据" />
          <template v-else>
            <el-row :gutter="20">
              <el-col :span="8">
                <el-statistic title="总数" :value="stats.agent_result_stats.total" />
              </el-col>
              <el-col :span="8">
                <el-statistic title="好评" :value="stats.agent_result_stats.likes">
                  <template #prefix>
                    <el-icon color="#67C23A"><SuccessFilled /></el-icon>
                  </template>
                </el-statistic>
              </el-col>
              <el-col :span="8">
                <el-statistic title="差评" :value="stats.agent_result_stats.dislikes">
                  <template #prefix>
                    <el-icon color="#F56C6C"><CircleCloseFilled /></el-icon>
                  </template>
                </el-statistic>
              </el-col>
            </el-row>
            <el-divider />
            <div class="like-rate">
              <span>好评率：</span>
              <el-progress
                :percentage="stats.agent_result_stats.like_rate"
                :color="getProgressColor(stats.agent_result_stats.like_rate)"
                :stroke-width="20"
              >
                <span class="percentage-text">{{ stats.agent_result_stats.like_rate }}%</span>
              </el-progress>
            </div>
          </template>
        </div>
      </el-tab-pane>

      <!-- 最终报告统计 -->
      <el-tab-pane label="最终报告" name="final_report">
        <div v-loading="loading" class="stats-content">
          <el-empty v-if="!stats" description="暂无数据" />
          <template v-else>
            <el-row :gutter="20">
              <el-col :span="8">
                <el-statistic title="总数" :value="stats.final_report_stats.total" />
              </el-col>
              <el-col :span="8">
                <el-statistic title="好评" :value="stats.final_report_stats.likes">
                  <template #prefix>
                    <el-icon color="#67C23A"><SuccessFilled /></el-icon>
                  </template>
                </el-statistic>
              </el-col>
              <el-col :span="8">
                <el-statistic title="差评" :value="stats.final_report_stats.dislikes">
                  <template #prefix>
                    <el-icon color="#F56C6C"><CircleCloseFilled /></el-icon>
                  </template>
                </el-statistic>
              </el-col>
            </el-row>
            <el-divider />
            <div class="like-rate">
              <span>好评率：</span>
              <el-progress
                :percentage="stats.final_report_stats.like_rate"
                :color="getProgressColor(stats.final_report_stats.like_rate)"
                :stroke-width="20"
              >
                <span class="percentage-text">{{ stats.final_report_stats.like_rate }}%</span>
              </el-progress>
            </div>
          </template>
        </div>
      </el-tab-pane>

      <!-- 最新评论 -->
      <el-tab-pane label="最新评论" name="comments">
        <div v-loading="loading" class="stats-content">
          <el-empty v-if="!stats || stats.recent_comments.length === 0" description="暂无评论" />
          <el-timeline v-else>
            <el-timeline-item
              v-for="comment in stats.recent_comments"
              :key="comment.id"
              :timestamp="formatTime(comment.created_at)"
              placement="top"
            >
              <el-card shadow="never" body-style="padding: 12px">
                <div class="comment-header">
                  <el-tag :type="comment.rating === 5 ? 'success' : 'danger'" size="small">
                    {{ comment.rating === 5 ? '好评' : '差评' }}
                  </el-tag>
                  <el-tag size="small" effect="plain">
                    {{ comment.target_type === 'agent_result' ? 'Agent报告' : '最终报告' }}
                  </el-tag>
                </div>
                <div class="comment-text">{{ comment.comment }}</div>
              </el-card>
            </el-timeline-item>
          </el-timeline>
        </div>
      </el-tab-pane>
    </el-tabs>
  </el-card>
</template>

<script setup>
import { ref, onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import { SuccessFilled, CircleCloseFilled } from '@element-plus/icons-vue'
import api from '@/utils/api'

const period = ref('7d')
const activeTab = ref('overall')
const loading = ref(false)
const stats = ref(null)

onMounted(() => {
  loadStats()
})

async function loadStats() {
  loading.value = true
  try {
    const response = await api.get('/api/admin/feedback/stats', {
      params: {
        period: period.value,
        target_type: 'all'
      }
    })
    stats.value = response.data
  } catch (error) {
    console.error('[FeedbackStats] Load stats failed:', error)
    if (error.response?.status === 403) {
      ElMessage.error('需要管理员权限')
    } else {
      ElMessage.error(error.response?.data?.detail || '加载统计失败')
    }
  } finally {
    loading.value = false
  }
}

function getProgressColor(percentage) {
  if (percentage >= 80) return '#67C23A'
  if (percentage >= 60) return '#E6A23C'
  return '#F56C6C'
}

function formatTime(isoString) {
  const date = new Date(isoString)
  return date.toLocaleString('zh-CN', {
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit'
  })
}
</script>

<style scoped>
.feedback-stats-card {
  margin-bottom: 20px;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stats-tabs {
  min-height: 300px;
}

.stats-content {
  padding: 20px 0;
  min-height: 250px;
}

.like-rate {
  margin-top: 20px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.percentage-text {
  font-weight: bold;
}

.comment-header {
  display: flex;
  gap: 8px;
  margin-bottom: 8px;
}

.comment-text {
  color: var(--el-text-color-regular);
  line-height: 1.6;
}
</style>
