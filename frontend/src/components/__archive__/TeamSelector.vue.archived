<template>
  <div class="team-selector">
    <div class="selector-container">
      <!-- 评审模式按钮 -->
      <el-button
        v-if="!isAgentSelected"
        :type="isLeaderSelected ? 'warning' : 'default'"
        :class="{ 'selected-button': isLeaderSelected }"
        @click="handleLeaderClick"
      >
        <el-icon><UserFilled /></el-icon>
        <span>评审模式</span>
        <el-icon v-if="isLeaderSelected" class="close-icon" @click.stop="handleClearLeader">
          <Close />
        </el-icon>
      </el-button>

      <!-- 选择 Agent 按钮 -->
      <el-button
        v-if="!isLeaderSelected"
        @click="showAgentSelector = true"
      >
        <el-icon><User /></el-icon>
        <span>{{ isAgentSelected ? '更换 Agent' : '选择 Agent' }}</span>
      </el-button>

      <!-- 选中的 Agent 标签 -->
      <el-tag
        v-if="isAgentSelected && selectedAgentInfo"
        closable
        size="large"
        type="info"
        @close="handleClearAgent"
        class="selected-tag"
      >
        <el-icon style="margin-right: 4px;"><User /></el-icon>
        {{ selectedAgentInfo.name }}
      </el-tag>
    </div>

    <!-- Agent 选择器对话框 -->
    <AgentSelector
      v-model="showAgentSelector"
      :selected-agent-id="selectedAgentValue"
      @select="handleAgentSelect"
    />
  </div>
</template>

<script setup>
import { ref, computed, onMounted, watch } from 'vue'
import { ElMessage } from 'element-plus'
import { User, UserFilled, Close } from '@element-plus/icons-vue'
import { useAgentsStore } from '@/stores/agents'
import { useLeaderStore } from '@/stores/leader'
import AgentSelector from './AgentSelector.vue'

// Stores
const agentsStore = useAgentsStore()
const leaderStore = useLeaderStore()

// State
const selectedAgentValue = ref(null)
const selectedMode = ref(null) // 'leader' | null
const showAgentSelector = ref(false)
const loading = ref(false)
const error = ref(null)

// Computed
const agents = computed(() => agentsStore.agents || [])

// 当前输入模式是否为评审模式（仅由用户选择决定，不受历史数据影响）
const isLeaderSelected = computed(() => selectedMode.value === 'leader')
const isAgentSelected = computed(() => selectedAgentValue.value !== null)

const selectedAgentInfo = computed(() => {
  if (!selectedAgentValue.value) return null
  return agents.value.find(a => a.id === selectedAgentValue.value) || null
})

// Methods
async function loadData() {
  loading.value = true
  error.value = null
  try {
    await agentsStore.fetchAgentTree()
  } catch (err) {
    error.value = '加载数据失败，请重试'
    console.error('Failed to load data:', err)
    ElMessage.error('加载数据失败，请重试')
  } finally {
    loading.value = false
  }
}

function handleLeaderClick() {
  if (selectedMode.value === 'leader') {
    handleClearLeader()
  } else {
    selectedMode.value = 'leader'
    selectedAgentValue.value = null
    emit('change', {
      type: 'team',
      id: 'leader',
      data: {
        id: 'leader',
        name: '评审模式',
        is_leader: true
      }
    })
  }
}

function handleAgentSelect(agent) {
  selectedAgentValue.value = agent.id
  selectedMode.value = null
  showAgentSelector.value = false
  emit('change', {
    type: 'agent',
    id: agent.id,
    data: agent
  })
}

function handleClearLeader() {
  selectedMode.value = null
  emit('change', { type: null, id: null, data: null })
}

function handleClearAgent() {
  selectedAgentValue.value = null
  emit('change', { type: null, id: null, data: null })
}

// Props
const props = defineProps({
  modelValue: {
    type: String,
    default: null // 'leader' | 'agent' | null
  }
})

// Emits
const emit = defineEmits(['change', 'update:modelValue'])

// Lifecycle
onMounted(() => {
  loadData()
})

// 监听外部 modelValue 变化，同步内部状态
watch(() => props.modelValue, (newVal) => {
  if (newVal === 'leader') {
    selectedMode.value = 'leader'
    selectedAgentValue.value = null
  } else if (newVal === 'agent') {
    // agent 模式需要 agent id，这里不做处理
  } else {
    selectedMode.value = null
  }
}, { immediate: true })
</script>

<style scoped>
.team-selector {
  width: 100%;
}

.selector-container {
  display: flex;
  align-items: center;
  gap: 12px;
}

.selected-button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
}

.close-icon {
  margin-left: 4px;
  cursor: pointer;
  flex-shrink: 0;
}

.close-icon:hover {
  opacity: 0.8;
}

.selected-tag {
  display: inline-flex;
  align-items: center;
  padding: 8px 16px;
  font-size: 14px;
  font-weight: 500;
  border-radius: 20px;
  cursor: default;
  max-width: 200px;
  white-space: nowrap;
  line-height: 1;
}

.selected-tag :deep(.el-tag__content) {
  display: inline-flex;
  align-items: center;
}

.selected-tag :deep(.el-icon) {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 移动端优化 */
@media (max-width: 768px) {
  .selector-container {
    gap: 8px;
  }

  /* 移动端隐藏按钮文字 */
  .selected-button span:not(.close-icon),
  .el-button span {
    display: none;
  }

  .selected-tag {
    max-width: 140px;
    font-size: 13px;
    padding: 6px 12px;
  }
}

@media (max-width: 480px) {
  .selected-tag {
    max-width: 120px;
  }
}
</style>
