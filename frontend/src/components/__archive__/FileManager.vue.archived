<template>
  <div class="file-manager">
    <el-card>
      <template #header>
        <div class="card-header">
          <h3>文件管理</h3>
          <el-button type="primary" size="small" @click="showUploadDialog = true">
            上传文件
          </el-button>
        </div>
      </template>

      <!-- 文件列表 -->
      <el-table
        :data="files"
        style="width: 100%"
        v-loading="loading"
        @row-click="handleRowClick"
      >
        <el-table-column prop="filename" label="文件名" min-width="200">
          <template #default="{ row }">
            <div class="filename-cell">
              <el-icon :size="20">
                <Document />
              </el-icon>
              <span>{{ row.filename }}</span>
            </div>
          </template>
        </el-table-column>

        <el-table-column prop="file_type" label="类型" width="150">
          <template #default="{ row }">
            <el-tag size="small">{{ getFileTypeLabel(row.file_type) }}</el-tag>
          </template>
        </el-table-column>

        <el-table-column prop="file_size" label="大小" width="120">
          <template #default="{ row }">
            {{ formatFileSize(row.file_size) }}
          </template>
        </el-table-column>

        <el-table-column prop="version" label="版本" width="80">
          <template #default="{ row }">
            <el-tag type="info" size="small">v{{ row.version }}</el-tag>
          </template>
        </el-table-column>

        <el-table-column prop="created_at" label="创建时间" width="180">
          <template #default="{ row }">
            {{ formatTime(row.created_at) }}
          </template>
        </el-table-column>

        <el-table-column label="操作" width="200" fixed="right">
          <template #default="{ row }">
            <el-button
              type="primary"
              size="small"
              @click.stop="previewFile(row)"
            >
              预览
            </el-button>
            <el-button
              type="success"
              size="small"
              @click.stop="downloadFile(row)"
            >
              下载
            </el-button>
            <el-button
              type="info"
              size="small"
              @click.stop="viewVersions(row)"
            >
              版本
            </el-button>
          </template>
        </el-table-column>
      </el-table>
    </el-card>

    <!-- 上传文件对话框 -->
    <el-dialog
      v-model="showUploadDialog"
      title="上传文件"
      width="500px"
    >
      <el-form :model="uploadForm" label-width="80px">
        <el-form-item label="文件">
          <el-upload
            ref="uploadRef"
            :auto-upload="false"
            :limit="1"
            :on-change="handleFileChange"
            :file-list="fileList"
          >
            <template #trigger>
              <el-button type="primary">选择文件</el-button>
            </template>
            <template #tip>
              <div class="el-upload__tip">
                支持上传代码文件、文档等，最大 10MB
              </div>
            </template>
          </el-upload>
        </el-form-item>
      </el-form>
      <template #footer>
        <el-button @click="showUploadDialog = false">取消</el-button>
        <el-button type="primary" :loading="uploading" @click="uploadFile">
          上传
        </el-button>
      </template>
    </el-dialog>

    <!-- 文件预览对话框 -->
    <el-dialog
      v-model="showPreviewDialog"
      :title="currentFile?.filename"
      width="80%"
      top="5vh"
    >
      <div v-if="previewLoading" class="preview-loading">
        <el-icon class="is-loading" :size="40">
          <Loading />
        </el-icon>
        <p>加载中...</p>
      </div>
      <div v-else class="preview-content">
        <pre v-if="isTextFile">{{ previewContent }}</pre>
        <div v-else class="unsupported">
          <el-icon :size="60"><Document /></el-icon>
          <p>此文件类型暂不支持预览</p>
          <el-button type="primary" @click="downloadFile(currentFile)">
            下载文件
          </el-button>
        </div>
      </div>
    </el-dialog>

    <!-- 版本历史对话框 -->
    <el-dialog
      v-model="showVersionsDialog"
      title="文件版本历史"
      width="70%"
    >
      <el-table :data="fileVersions" v-loading="versionsLoading">
        <el-table-column prop="version" label="版本" width="80">
          <template #default="{ row }">
            <el-tag>v{{ row.version }}</el-tag>
          </template>
        </el-table-column>

        <el-table-column prop="file_size" label="大小" width="120">
          <template #default="{ row }">
            {{ formatFileSize(row.file_size) }}
          </template>
        </el-table-column>

        <el-table-column prop="created_at" label="创建时间" width="180">
          <template #default="{ row }">
            {{ formatTime(row.created_at) }}
          </template>
        </el-table-column>

        <el-table-column label="操作" width="200">
          <template #default="{ row }">
            <el-button
              type="primary"
              size="small"
              @click="previewVersion(row)"
            >
              预览
            </el-button>
            <el-button
              type="success"
              size="small"
              @click="downloadVersion(row)"
            >
              下载
            </el-button>
          </template>
        </el-table-column>
      </el-table>
    </el-dialog>
  </div>
</template>

<script setup>
import { ref, onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import dayjs from 'dayjs'

const props = defineProps({
  conversationId: {
    type: Number,
    required: true
  }
})

const loading = ref(false)
const uploading = ref(false)
const files = ref([])
const fileList = ref([])
const uploadRef = ref(null)
const uploadForm = ref({
  file: null
})

const showUploadDialog = ref(false)
const showPreviewDialog = ref(false)
const showVersionsDialog = ref(false)

const currentFile = ref(null)
const previewContent = ref('')
const previewLoading = ref(false)
const isTextFile = ref(true)

const fileVersions = ref([])
const versionsLoading = ref(false)

// 加载文件列表
async function loadFiles() {
  loading.value = true
  try {
    const response = await fetch(`/api/files?conversation_id=${props.conversationId}`, {
      headers: {
        'Authorization': `Bearer ${localStorage.getItem('token')}`
      }
    })
    const data = await response.json()
    files.value = data.files || []
  } catch (error) {
    ElMessage.error('加载文件列表失败')
  } finally {
    loading.value = false
  }
}

// 文件选择变化
function handleFileChange(file) {
  uploadForm.value.file = file.raw
}

// 上传文件
async function uploadFile() {
  if (!uploadForm.value.file) {
    ElMessage.warning('请选择文件')
    return
  }

  // 检查文件大小 (10MB)
  if (uploadForm.value.file.size > 10 * 1024 * 1024) {
    ElMessage.error('文件大小不能超过 10MB')
    return
  }

  uploading.value = true
  const formData = new FormData()
  formData.append('file', uploadForm.value.file)
  formData.append('conversation_id', props.conversationId)

  try {
    const response = await fetch('/api/files/upload', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${localStorage.getItem('token')}`
      },
      body: formData
    })

    const data = await response.json()

    if (response.ok) {
      ElMessage.success('上传成功')
      showUploadDialog.value = false
      fileList.value = []
      uploadForm.value.file = null
      loadFiles()
    } else {
      ElMessage.error(data.error || '上传失败')
    }
  } catch (error) {
    ElMessage.error('上传失败')
  } finally {
    uploading.value = false
  }
}

// 预览文件
async function previewFile(file) {
  currentFile.value = file
  showPreviewDialog.value = true
  previewLoading.value = true
  previewContent.value = ''

  try {
    const response = await fetch(`/api/files/${file.id}/preview`, {
      headers: {
        'Authorization': `Bearer ${localStorage.getItem('token')}`
      }
    })

    const data = await response.json()

    if (response.ok) {
      isTextFile.value = true
      previewContent.value = data.content
    } else {
      isTextFile.value = false
    }
  } catch (error) {
    isTextFile.value = false
  } finally {
    previewLoading.value = false
  }
}

// 下载文件
async function downloadFile(file) {
  try {
    const response = await fetch(`/api/files/${file.id}/download`, {
      headers: {
        'Authorization': `Bearer ${localStorage.getItem('token')}`
      }
    })

    if (!response.ok) {
      ElMessage.error('下载失败')
      return
    }

    const blob = await response.blob()
    const url = window.URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = file.filename
    a.click()
    window.URL.revokeObjectURL(url)
  } catch (error) {
    ElMessage.error('下载失败')
  }
}

// 查看版本历史
async function viewVersions(file) {
  currentFile.value = file
  showVersionsDialog.value = true
  versionsLoading.value = true

  try {
    const response = await fetch(`/api/files/${file.id}/versions`, {
      headers: {
        'Authorization': `Bearer ${localStorage.getItem('token')}`
      }
    })

    const data = await response.json()
    fileVersions.value = data.versions || []
  } catch (error) {
    ElMessage.error('加载版本历史失败')
  } finally {
    versionsLoading.value = false
  }
}

// 预览特定版本
async function previewVersion(version) {
  currentFile.value = version
  showVersionsDialog.value = false
  await previewFile(version)
}

// 下载特定版本
async function downloadVersion(version) {
  currentFile.value = version
  await downloadFile(version)
}

// 点击行
function handleRowClick(row) {
  previewFile(row)
}

// 获取文件类型标签
function getFileTypeLabel(type) {
  const typeMap = {
    'text/markdown': 'Markdown',
    'text/x-python': 'Python',
    'text/javascript': 'JavaScript',
    'text/typescript': 'TypeScript',
    'text/x-vue': 'Vue',
    'text/html': 'HTML',
    'text/css': 'CSS',
    'application/json': 'JSON',
    'text/plain': 'Text',
    'text/yaml': 'YAML',
    'text/xml': 'XML',
    'text/x-sql': 'SQL',
    'text/x-sh': 'Shell'
  }
  return typeMap[type] || type
}

// 格式化文件大小
function formatFileSize(bytes) {
  if (!bytes) return '0 B'
  const k = 1024
  const sizes = ['B', 'KB', 'MB', 'GB']
  const i = Math.floor(Math.log(bytes) / Math.log(k))
  return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i]
}

// 格式化时间
function formatTime(time) {
  return dayjs(time).format('YYYY-MM-DD HH:mm:ss')
}

onMounted(() => {
  loadFiles()
})

// 暴露方法给父组件
defineExpose({
  loadFiles
})
</script>

<style scoped>
.file-manager {
  padding: 20px;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-header h3 {
  margin: 0;
}

.filename-cell {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
}

.filename-cell:hover {
  color: #409eff;
}

.preview-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400px;
}

.preview-content {
  max-height: 70vh;
  overflow: auto;
}

.preview-content pre {
  background: #f5f7fa;
  padding: 16px;
  border-radius: 4px;
  overflow-x: auto;
  font-family: 'Courier New', monospace;
  font-size: 14px;
  line-height: 1.6;
}

.unsupported {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400px;
  color: #909399;
}

.unsupported p {
  margin: 16px 0;
  font-size: 16px;
}
</style>
